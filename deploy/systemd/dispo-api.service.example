[Unit]
Description=Dispo API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/dispo/server
Environment=DISPO_DATABASE_URL=sqlite:////var/lib/dispo/dispo.db
Environment=DISPO_UPLOAD_DIR=/var/lib/dispo/uploads
Environment=DISPO_DEMO_MODE=1
Environment=DISPO_CORS_ORIGINS=*
ExecStart=/home/pi/dispo/server/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
