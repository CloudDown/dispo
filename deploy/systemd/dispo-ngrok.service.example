[Unit]
Description=Dispo API public tunnel (ngrok)
After=network-online.target dispo-api.service
Wants=network-online.target
Requires=dispo-api.service

[Service]
Type=simple
User=pi
Group=pi
Environment=HOME=/home/pi
ExecStart=/usr/local/bin/ngrok http 8000 --log=stdout
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
